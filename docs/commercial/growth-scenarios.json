  "operational_limits": {
    "support_capacity": {
      "assumption": "1 full-time support agent = 160 hours/month",
      "base_scenario_capacity_per_agent": {
        "conservative": 960,
        "base": 1200,
        "stretch": 1920
      },
      "agents_needed_at_500_customers": {
        "conservative": 1,
        "base": 1,
        "stretch": 1
      }
    },
    "infrastructure_scaling": {
      "assumption": "Infrastructure scales linearly with active customers and scan volume",
      "cost_at_1000_customers": {
        "conservative": 1440.0,
        "base": 1240.0,
        "stretch": 1600.0
      }
    },
    "payment_failure_rate": {
      "assumption": "2% of recurring payments fail monthly",
      "revenue_impact_at_500_customers": {
        "conservative": 90.0,
        "base": 120.0,
        "stretch": 150.0
      }
    }
  },
  "unit_economics_benchmarks": {
    "gross_margin_targets": {
      "early_launch": "65-75%",
      "scale_phase": "70-80%",
      "mature": ">75%"
    },
    "customer_lifetime_value": {
      "formula": "arpu / monthly_churn_rate",
      "conservative": {
        "arpu": 15.0,
        "monthly_churn_rate": 0.08,
        "clv": 187.5
      },
      "base": {
        "arpu": 15.0,
        "monthly_churn_rate": 0.05,
        "clv": 300.0
      },
      "stretch": {
        "arpu": 15.0,
        "monthly_churn_rate": 0.03,
        "clv": 500.0
      }
    },
    "ltv_cac_ratio": {
      "formula": "clv / customer_acquisition_cost",
      "conservative": 7.5,
      "base": 15.0,
      "stretch": 33.3,
      "benchmark": ">3.0 is healthy, >5.0 is excellent"
    },
    "payback_period": {
      "formula": "customer_acquisition_cost / (arpu * gross_margin_percentage)",
      "conservative_months": 2.2,
      "base_months": 1.8,
      "stretch_months": 1.3,
      "benchmark": "<12 months is healthy, <6 months is excellent"
    }
  },
  "validation_rules": {
    "required_fields": [
      "mrr",
      "one_time_revenue",
      "total_revenue",
      "payment_processing_fees",
      "infrastructure_cost",
      "support_cost",
      "direct_costs",
      "gross_margin",
      "gross_margin_percentage",
      "customer_acquisition_cost",
      "support_capacity_customers"
    ],
    "consistency_checks": {
      "gross_margin_calculation": "gross_margin == total_revenue - direct_costs",
      "margin_percentage_calculation": "gross_margin_percentage == (gross_margin / total_revenue) * 100",
      "positive_values": ["mrr", "total_revenue", "gross_margin", "gross_margin_percentage"],
      "churn_bounds": "monthly_churn_rate > 0 && monthly_churn_rate < 0.2"
    },
    "scenario_ordering": {
      "conservative_lower_than_base": "conservative.mrr < base.mrr",
      "base_lower_than_stretch": "base.mrr < stretch.mrr"
    }
  }
