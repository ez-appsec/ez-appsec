  "metadata": {
    "version": "1.0",
    "last_updated": "2024-06-25",
    "model_type": "unit_economics_scenarios",
    "currency": "USD",
    "time_period": "monthly"
  },
  "assumptions": {
    "payment_processing": {
      "stripe_fixed_fee_per_transaction": 0.30,
      "stripe_percentage_fee": 0.029,
      "description": "Stripe payment processing fees (2.9% + $0.30)"
    },
    "infrastructure": {
      "scan_processing_cost_per_scan": 0.05,
      "storage_cost_per_gb_per_month": 0.023,
      "compute_cost_per_month_base": 50.0,
      "compute_cost_per_customer_additional": 0.10,
      "description": "AWS/cloud infrastructure cost assumptions"
    },
    "support": {
      "average_support_minutes_per_customer_month": 8.0,
      "support_cost_per_minute": 0.50,
      "description": "Human support time and cost per customer"
    },
    "customer_lifecycle": {
      "early_launch_customer_count": 25,
      "launch_monthly_monitoring_price": 15.0,
      "one_time_security_check_price": 20.0,
      "one_time_acceptance_report_price": 50.0,
      "description": "Pricing and customer count assumptions"
    }
  },
  "formulas": {
    "mrr": "active_subscribers * monthly_price",
    "one_time_revenue": "one_time_purchases * average_one_time_price",
    "total_revenue": "mrr + one_time_revenue",
    "payment_processing_fees": "(mrr * stripe_percentage_fee) + (subscription_count * stripe_fixed_fee) + (one_time_revenue * stripe_percentage_fee) + (one_time_transactions * stripe_fixed_fee)",
    "infrastructure_cost": "compute_cost_base + (active_customers * compute_cost_per_customer) + (total_scans * scan_processing_cost) + (storage_gb * storage_cost_per_gb)",
    "support_cost": "active_customers * support_minutes_per_customer * support_cost_per_minute",
    "direct_costs": "payment_processing_fees + infrastructure_cost + support_cost",
    "gross_margin": "total_revenue - direct_costs",
    "gross_margin_percentage": "(gross_margin / total_revenue) * 100",
    "customer_acquisition_cost": "marketing_spend / new_customers",
    "support_capacity_customers": "(available_support_hours_monthly * 60) / support_minutes_per_customer",
    "churned_customers": "active_customers * monthly_churn_rate",
    "revenue_churn_amount": "churned_customers * monthly_price"
  },
